# Copy to .env for local development:  cp .env.example .env
# Next.js, drizzle-kit and `pnpm db:migrate` all read it. The values below
# match the `db` service in docker-compose.yml.

# --- App --------------------------------------------------------------------
# Which deployment this is: local | preview | staging | production.
# Branch on APP_ENV for behaviour switches, not on VERCEL_ENV.
# Defaults to local; every Vercel environment must set it.
APP_ENV=local

# Canonical base URL of the site, used for absolute URLs such as Open Graph
# images. Only the server reads it, so it has no NEXT_PUBLIC_ prefix, but
# prerendered pages bake it in at build time: set it for `next build` too.
# Defaults to http://localhost:3000 locally and to https://$VERCEL_BRANCH_URL
# on a Vercel preview; staging and production must set it.
APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# On Vercel both URLs go to PgBouncer on the VPS over TLS, checked against
# its Let's Encrypt certificate:
#   postgres://<role>:<password>@db.shipped-it.dev:6432/<database>?sslmode=verify-full
# PgBouncer sends database `foa` to pg-prod and every other name to
# pg-nonprod (foa_staging and the preview databases).
#   Production: database foa,         roles foa_app / foa_migrator
#   Staging:    database foa_staging, roles staging_app / staging_migrator
#   Preview:    database foa_pr (a placeholder), roles nonprod_app /
#               nonprod_migrator. The app and `pnpm db:migrate` swap in the
#               preview's own database, foa_pr_<PR number>, or
#               foa_br_<branch>_<hash> before the branch has a PR; the migration
#               creates it from the foa_seed template.
# Locally there is no sslmode, so the connection stays plain.

# Runtime connection used by the app. The server won't start without it
# (src/instrumentation.ts); `next build` works without it.
#   Local:  postgres://foa:foa@localhost:5432/foa  (docker compose up -d db)
#   Vercel: the app role (DML only), which PgBouncer pools by transaction
DATABASE_URL=postgres://foa:foa@localhost:5432/foa

# Connection for `pnpm db:migrate` and drizzle-kit, which never fall back to
# DATABASE_URL (transaction pooling breaks the migration's advisory lock).
#   Local:  the same URL as DATABASE_URL
#   Vercel: the migrator role (schema owner), which PgBouncer gives session
#           mode through its per-user pool_mode
DIRECT_URL=postgres://foa:foa@localhost:5432/foa

# --- Sign-in -----------------------------------------------------------------
# Signs session cookies and keys the sign-in code rate limits. Staging and
# production must each set their own (32+ characters): openssl rand -hex 32.
# A local run or a preview without it uses a public development secret.
# BETTER_AUTH_SECRET=

# Outside production every email goes to the capture mailbox instead of being
# sent. GET /api/capture-mailbox?to=<address> with the header
# x-capture-mailbox-token: <this value> reads it (the Seam 2 journeys do).
# Unset, the mailbox stays closed (404). Never set in production.
# CAPTURE_MAILBOX_TOKEN=
